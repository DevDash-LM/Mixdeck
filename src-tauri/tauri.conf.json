{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mixdeck",
  "version": "0.1.0",
  "identifier": "s4lo.lol.mixdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mixdeck",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "s4lo",
    "category": "Music",
    "shortDescription": "A control surface for Voicemeeter Potato",
    "longDescription": "Mixdeck is a clean, resizable mixer that controls a running Voicemeeter Potato through its official Remote API. It processes no audio itself and does not include any Voicemeeter files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
